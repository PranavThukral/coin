# Copy to .env.local. Never commit real values.

# Postgres (Neon or Supabase). Use the pooled URL on Vercel.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Model provider. Set the exact model id from the provider's model list.
OPENAI_API_KEY=
OPENAI_MODEL=
# USD per million tokens, copied from the provider's pricing page (verify, don't guess).
PRICE_INPUT_USD_PER_MTOK=
PRICE_OUTPUT_USD_PER_MTOK=

# 1 = Live mode off (scripted demo keeps working).
COIN_KILL_SWITCH=0

# Random string; salts IP hashes for rate limiting.
IP_HASH_SALT=

# Eval harness only. Use a SEPARATE key from the public one.
EVAL_OPENAI_API_KEY=
